if game:IsLoaded() ~= true then
    game.Loaded:Wait()
end

local function checkandrun()
    local ui = gethui()
    if ui == nil then ui = game:GetService("CoreGui") end
    if ui then
        local script = false
        for _, desc in pairs(ui:GetDescendants()) do
            if string.find(string.lower(desc.Name), "cascade") then
                script = true
            end
            if desc.Name == "Base" then
                script = true    
            end
            if string.find(string.lower(desc.Name), "windui") then
                script = true
            end
        end

        if script == false then

            pcall(function()
                loadstring(game:HttpGet("https://vss.pandauth.com/kv/aee0f08426a8570e"))()
            end)

        end 
    end
end


task.delay(0.25, function()

    
    pcall(function()
        loadstring(game:HttpGet("https://vss.pandauth.com/kv/aee0f08426a8570e"))()
    end)

    while task.wait(20) do
        checkandrun()
    end

end)
